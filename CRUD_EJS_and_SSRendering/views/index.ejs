<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
    <link rel = "stylesheet" href = "/stylesheets/style.css">

</head>
<body>
   <div class ="min-h-screen w-full bg-zinc-900 p-10 text-white">
    
    <div class=" nav mb-8 flex flex-nowrap">
        <a class="text-zinc-500 " href="/read">Read Users</a>
    </div>

    <h1> Create User</h1>
    <form action ="/create" method="post">  
        <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg bg-transparent" type="text" name="username" placeholder="Enter your name">
        <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg bg-transparent" type="text" name="email" placeholder="Email" >
        <input class="px-5 py-2 border-2 border-zinc-700 outline-none rounded-lg bg-transparent" type="text" name="imageUrl" placeholder="Image URL">
        <input class="px-5 py-2 bg-blue-500 ml-3 hover:bg-blue-500 rounded-md" type = "submit" value="Create User">  
    </form>
   </div>
</body>
</html> 